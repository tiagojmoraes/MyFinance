{
  "expo": {
    "name": "MyFinance",
    "slug": "myfinance",
    "version": "25.0.0",
    "scheme": "myfinance",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#036c50"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.zai.myfinancepantry",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o uso da câmera para escanear o QR Code da NFC-e."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "./plugins/withWebViewSefazSsl"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa398e86-285f-4d53-aec7-4c95f9877fea"
      }
    }
  }
}
