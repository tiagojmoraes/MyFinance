{
  "name": "myfinance",
  "version": "93.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:all": "jest --no-coverage --silent",
    "build:apk": "eas build -p android --profile preview",
    "dev": "concurrently \"node tools/servidor-nfce.js\" \"expo start -c\"",
    "dev:pc": "node tools/servidor-nfce.js",
    "dev:expo": "expo start -c",
    "check": "node tools/check-inicializacao.js",
    "fix:limpo": "node tools/check-inicializacao.js --fix",
    "dev:servidor": "node tools/servidor-nfce.js",
    "dev:expo8082": "expo start -c --port 8082",
    "dev:separado": "echo Use 2 terminais: 1) npm run dev:servidor  2) npm run dev:expo8082"
  },
  "dependencies": {
    "@shopify/flash-list": "2.3.3",
    "expo": "~58.0.13",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "nativewind": "4.2.7",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "better-sqlite3": "^13.2.0",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  },
  "private": true,
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  },
  "overrides": {
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest",
        "typescript"
      ]
    }
  }
}
